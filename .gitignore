# =========================================================================
# MetroGuard AI — Official .gitignore
# =========================================================================

# --- Python Runtime & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints
.pytest_cache/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Large Raw Datasets (>100MB GitHub Limit) ---
# Raw benchmark CSVs and archive dumps are excluded from git.
# Download from UCI Machine Learning Repository (Dataset #791: MetroPT-3).
data/raw/*.csv
data/raw/*.zip
data/processed/metropt3_features.csv
data/processed/metropt3_labeled.csv

# Keep pre-processed binary caches required for instant demo execution
!data/processed/streaming_scenarios_cache.pkl
!data/processed/dashboard_telemetry_cache.joblib

# --- Production Models & Metadata (Preserved in Repo) ---
# Machine learning model artifacts and evaluations are tracked
!models/metroguard_model.pkl
!models/metroguard_anomaly_model.pkl
!models/*.json
!models/*.csv
!models/*.png

# --- Node / Frontend Build ---
frontend/node_modules/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Note: frontend/dist/ is intentionally preserved as it is served by FastAPI

# --- Environment & Security ---
.env
.env.*
*.key
*.pem
credentials.json

# --- OS & Editor Metadata ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.exe

